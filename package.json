{
  "name": "helios-outreach-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Helios Outreach Hub — product app inside The Helios Hub",
  "scripts": {
    "dev": "node scripts/dev_with_worker.js",
    "dev:web": "node scripts/patch_next_swc_fallback.js && next dev",
    "build": "next build",
    "start": "next start",
    "db:bootstrap": "psql \"%DIRECT_DATABASE_URL%\" -f db/bootstrap.sql",
    "db:outreach": "node scripts/apply_outreach_schema.js",
    "db:drafting": "node scripts/apply_drafting_schema.js",
    "db:reply": "node scripts/apply_reply_schema.js",
    "db:orchestration": "node scripts/apply_orchestration_schema.js",
    "db:analytics": "node scripts/apply_analytics_schema.js",
    "db:dashboards": "node scripts/apply_dashboards_schema.js",
    "db:dashboards:migrate-data": "node scripts/migrate_dashboards_data.js",
    "db:networking": "node scripts/apply_networking_schema.js",
    "db:trello": "node scripts/apply_trello_schema.js",
    "db:trello:migrate-data": "node scripts/migrate_trello_data.js",
    "db:setup": "node scripts/db_setup.js",
    "db:gen-bootstrap": "node scripts/gen_bootstrap.js",
    "worker": "tsx scripts/orchestration_worker.ts",
    "worker:dev": "tsx watch scripts/orchestration_worker.ts",
    "worker:status": "tsx scripts/orchestration_status.ts",
    "verify:orchestration": "node scripts/verify_orchestration_schema.js",
    "verify:drafting": "tsx scripts/verify_drafting_schema.ts",
    "verify:analytics": "tsx scripts/verify_analytics_hub.ts",
    "drafting:sync-manifest": "node scripts/sync_drafting_manifests.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:db:drafting-cost": "tsx tests/drafting-cost-persistence.integration.ts",
    "test:m6": "tsx --test tests/m6.test.ts",
    "test:extraction": "tsx --test tests/vision-extraction.test.ts",
    "verify:m6": "tsx scripts/verify_m6_pipeline.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/supabase-js": "^2.45.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.12.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.0.0",
    "resend": "^6.18.1",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  }
}
