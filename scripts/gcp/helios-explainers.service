[Unit]
Description=Helios Explainer Reels worker (one render at a time)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Non-root: Claude Code refuses --dangerously-skip-permissions as root, and the
# Explainers render agent needs it (lib/explainers/render/agent.ts). systemd reads
# EnvironmentFile as root before dropping to helios, so worker.env stays mode 600.
User=helios
Group=helios
Environment=HOME=/opt/helios-social/home
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/helios-social/ms-playwright
# helios-social-worker (docs/social-overnight.md). Render work and local copies live
# under /opt/helios-social/explainers (EXPLAINERS_JOBS_DIR, EXPLAINERS_STORAGE_DIR in
# worker.env), so a redeploy of the app directory never removes them.
WorkingDirectory=/opt/helios-social/app
EnvironmentFile=/opt/helios-social/worker.env
ExecStart=/usr/bin/npm run explainers:worker
Restart=always
RestartSec=15
KillSignal=SIGTERM
# A render in flight is failed on restart and retried by Lucas's click; give it time to wind down.
TimeoutStopSec=120
# PROVISIONAL (E-21, A-6). Not measured on the VM yet. The M4 fixture render on a Mac
# peaked near 1 GB for the CLI process alone, before Chrome workers and the Claude Code
# agent processes. Replace all three values from the E-21 protocol after the first live
# run. The VM is an e2-medium (4 GB + 4 GB swap); renders run at 2 AM, alone.
MemoryHigh=2000M
MemoryMax=2500M
# Above helios-worker (5) and level with helios-reels (10): renders yield to outreach.
Nice=10

[Install]
WantedBy=multi-user.target
