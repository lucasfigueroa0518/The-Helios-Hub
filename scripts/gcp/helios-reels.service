[Unit]
Description=Helios Trial Reels worker (nightly ingest and reel frames)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Non-root: Claude Code refuses --dangerously-skip-permissions as root, and the
# Explainers render agent needs it (lib/explainers/render/agent.ts). systemd reads
# EnvironmentFile as root before dropping to helios, so worker.env stays mode 600.
User=helios
Group=helios
Environment=HOME=/opt/helios-social/home
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/helios-social/ms-playwright
WorkingDirectory=/opt/helios-social/app
EnvironmentFile=/opt/helios-social/worker.env
ExecStart=/usr/bin/npm run reels:worker
Restart=always
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=300
# Runs on helios-social-worker (e2-medium, 4 GB + 4 GB swap); the other social
# workers run at other hours (docs/social-overnight.md).
MemoryMax=1500M
MemoryHigh=1200M
Nice=10

[Install]
WantedBy=multi-user.target
