[Unit]
Description=Helios Trial Reels worker (nightly ingest and reel frames)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/helios-social/app
EnvironmentFile=/opt/helios-social/worker.env
ExecStart=/usr/bin/npm run reels:worker
Restart=always
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=300
# Runs on helios-social-worker (e2-medium, 4 GB + 4 GB swap); the other social
# workers run at other hours (docs/social-overnight.md).
MemoryMax=1500M
MemoryHigh=1200M
Nice=10

[Install]
WantedBy=multi-user.target
