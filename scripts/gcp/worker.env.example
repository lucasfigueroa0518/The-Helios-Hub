# Copy to scripts/gcp/worker.env (gitignored) and fill from .env.local.
# This file is uploaded to the GCP worker VM — never commit real secrets.

# Database (worker prefers DIRECT_DATABASE_URL)
DIRECT_DATABASE_URL=
DATABASE_URL=
# Cloud worker is the only process on the VM (no Next.js pool). Size this
# to the in-flight job cap so research shards are not stuck waiting on pg.
PG_POOL_MAX=8

ORCHESTRATOR=postgres
ORCHESTRATION_POLL_MS=400
ORCHESTRATION_LEASE_SECONDS=600
# Laptop-equivalent drafting: 4 research shards + 1 write + mailbox/maintenance.
# Effective limits are derived from DRAFTING_ANTHROPIC_MAX_INFLIGHT (see
# lib/drafting/provider-admission.ts) — these ceilings must match local.
ORCHESTRATION_WORKER_MAX_CONCURRENCY=16
ORCHESTRATION_WORKER_ID=gcp-e2-micro-1
# This VM is the fallback. It yields while any laptop/dev worker heartbeat is
# healthy, then claims again ~45s after the machine goes away.
ORCHESTRATION_FALLBACK_WORKER_ID=gcp-e2-micro-1
DRAFTING_ANTHROPIC_MAX_INFLIGHT=8

# Lane caps — same admission as the laptop worker
ORG_EMAIL_SEND_CONCURRENCY=2
# Every Smartlead write goes through one lane. Smartlead rate-limits per API
# key across all endpoints, and lane creation must stay ordered ahead of the
# handoffs that depend on it. Max 3.
ORG_SMARTLEAD_CONCURRENCY=1
ORG_EXTRACTION_CONCURRENCY=3
ORG_RESEARCH_CONCURRENCY=2
ORG_PROFILE_RESCUE_CONCURRENCY=2
ORG_EMAIL_RESCUE_CONCURRENCY=2
ORG_FINALIZE_CONCURRENCY=2
ORG_VERIFY_CONCURRENCY=2
ORG_MAILBOX_VERIFY_CONCURRENCY=3
ORG_DRAFT_RESEARCH_CONCURRENCY=8
ORG_DRAFT_WRITE_CONCURRENCY=8
ORG_DASHBOARDS_CONCURRENCY=1

# Providers the worker may call
# Must be a live org key (not disabled). Keep in sync with .env.local —
# deploy-worker-code.sh probes this and refuses to ship a dead key.
ANTHROPIC_API_KEY=
# Admin API key for GET /v1/organizations/cost_report (Analytics Hub billed totals).
ANTHROPIC_ADMIN_API_KEY=

# Helios Dashboards — decrypt per-user GitHub PATs for sync (AES-256-GCM).
# Same value as app TOKEN_ENCRYPTION_KEY. Never log decrypted tokens.
# TOKEN_ENCRYPTION_KEY=


# Supabase Storage — required for sheet extraction / pre-enriched ingest
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mailbox / drafting modes should match production app
DRAFTING_MODE=live
EXTRACTION_MODE=live
# Static Claude prefix cache TTL (5m or 1h). See docs/prompt-caching.md
DRAFTING_PROMPT_CACHE_TTL=1h

# Absolute origin for HTML email signature image URLs (must be publicly reachable)
HELIOS_PUBLIC_URL=https://www.heliosgroup.tech

# Smartlead — delivery and warmup. The worker owns every write.
SMARTLEAD_API_KEY=
# Kill switch. Until this is exactly "true", every smartlead.* / inbox.* handler
# no-ops and the webhook route answers 503, so a bad deploy cannot take the
# shared enrichment and drafting lanes down with it.
SMARTLEAD_ENABLED=false
# Smartlead publishes no payload signature (see docs/smartlead-s0-findings.md),
# so the webhook authenticates by a 32-byte path token. The worker needs it to
# register the callback URL; the app needs it to accept the callback.
SMARTLEAD_WEBHOOK_PATH_TOKEN=
# Only used if Smartlead ever starts signing payloads (org_settings mode 'hmac').
# SMARTLEAD_WEBHOOK_SECRET=

# Gmail Postmaster Tools — nightly recipient-side audit. Missing values skip the
# job rather than failing it. Expect mostly no_data at this volume.
POSTMASTER_CLIENT_ID=
POSTMASTER_CLIENT_SECRET=
POSTMASTER_REFRESH_TOKEN=

# AgentMail — retained only for the test-address verifier, not for outreach.
AGENT_MAIL_API=
# Verify-only throwaway inbox. Must stay abcdefg@agentmail.to.
AGENTMAIL_INBOX_ID=abcdefg@agentmail.to

# Apollo — Auto campaign list sourcing (people search free; enrich paid)
APOLLO_API_KEY=
# Organization search is 1 credit/page and off unless explicitly enabled.
# AUTO_APOLLO_ORG_SEARCH=1
